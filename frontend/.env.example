# API base URL (must include /api/v1 — see src/services/apiClient.ts)
NEXT_PUBLIC_API_URL=https://backend.shivanshu.shop/api/v1

# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Enterprise SSO: set to "true" when Google/Microsoft OIDC is wired (see login page)
# NEXT_PUBLIC_SSO_LIVE=false

NEXT_PUBLIC_APP_NAME="GCRAI Enterprise Assessment Platform"

# Public site URL (invite copy links in admin UI; should match backend CLIENT_BASE_URL)
NEXT_PUBLIC_APP_URL=https://gcri-project.vercel.app
# Local development:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
